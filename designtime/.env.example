# Postgres registry. docker-compose sets this for the api service; export it
# yourself when running uvicorn or alembic on the host.
DATABASE_URL=postgresql+psycopg2://designtime:designtime@localhost:5432/designtime

# The runtime engine build the evaluation harness replays against (DT-29, DT-37).
ENGINE_VERSION=2.1.3
ENGINE_RANGE=">=2.1.0 <3.0.0"

# Generation guardrails (DT-08, DT-10).
FIELD_SUPPORT_MIN=0.6
RULE_SUPPORT_MIN=3

# Corpus intake floors (DT-18) and the deterministic hold-out split (DT-22).
CORPUS_MIN_PER_TYPE=25
CORPUS_MIN_HELDOUT=5
HELDOUT_FRACTION=0.2

# Pattern learning (POST /learning/runs). Defaults suit a repo checkout: the
# runtime next to this folder, its configs, and its data folder for sources.
# RUNTIME_DIR=../runtime
# RUNTIME_PYTHON=python            # an interpreter with runtime/requirements.txt installed
# RUNTIME_CONFIG_ROOT=../runtime/configs
# LEARNING_INPUT_ROOT=../runtime/data
# LEARNING_MODEL_PROVIDER=stub     # force the isolated runtime onto the stub; unset = each config's own
LEARNING_MAX_ITERATIONS=3
LEARNING_REGRESSION_SAMPLES=20
RUNTIME_TIMEOUT_S=300

# In-flight learning calls keep a scratch copy of the configs here (resume needs it).
# LEARNING_STATE_DIR=/tmp/dataextractor-learning
# The runtime service, for POST /learning/corrections without items (fetches the review export).
# RUNTIME_URL=http://localhost:8001

# Model gateway: when set, the pattern skill writer drafts skills through it.
# MODEL_GATEWAY_URL=
# MODEL_GATEWAY_TOKEN=
